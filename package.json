{
  "name": "clarifai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "firebase emulators:exec --only firestore --project demo-clarifai --ui \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-clarifai \"vitest run --project emulator\"",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-clarifai \"playwright test\"",
    "scrape": "tsx scripts/scrape.ts",
    "codes:generate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/generate-codes.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm test:emulator",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.26.0"
}
