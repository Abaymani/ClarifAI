# Copy to .env.local and fill in real values there. Never commit real values (see AGENTS.md).
# `pnpm dev` and all tests use the local Firestore emulator, so the Firebase values are
# only needed on Vercel.

# Firebase Admin SDK service account (Firebase console > Project settings > Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The key on a single line, with its line breaks written as \n.
FIREBASE_PRIVATE_KEY=

# Firebase Authentication for the hidden researcher portal. Find the Web API key
# under Firebase console > Project settings > General. Only these two verified
# Google addresses can access /admin; configure their real values in Vercel and
# .env.local, never in Git.
FIREBASE_WEB_API_KEY=
ADMIN_RESEARCHER_1_EMAIL=
ADMIN_RESEARCHER_2_EMAIL=

# OpenAI API key for the transcript analysis (S2). Without it, `pnpm dev` uses a fake
# analyser that codes by keyword (results are marked as fake), and deployed builds stop
# with error S2-CONFIG.
OPENAI_API_KEY=
# Optional. Defaults: gpt-6-sol, medium (none, low, medium, high, xhigh or max), and 3
# reflection questions per student (1–10).
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
REFLECTION_MAX_QUESTIONS=
