# Copy to .env.local and fill in real values there. Never commit real values (see AGENTS.md).
# `pnpm dev` and all tests use the local Firestore emulator, so the Firebase values are
# only needed on Vercel.

# Firebase Admin SDK service account (Firebase console > Project settings > Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The key on a single line, with its line breaks written as \n.
FIREBASE_PRIVATE_KEY=

# OpenAI API key for the transcript analysis (S2).
OPENAI_API_KEY=
