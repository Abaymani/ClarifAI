# AGENTS.md forbids committing secrets, so commits are blocked when the scanner is missing.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed, so this commit can't be checked for secrets." >&2
  echo "Install it using the instructions in README.md and commit again." >&2
  exit 1
fi

# Ubuntu 26.04 packages gitleaks 8.16, which predates the `git` subcommand.
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner --verbose
else
  gitleaks protect --staged --redact --no-banner --verbose
fi
